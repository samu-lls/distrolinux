---
import Logo from './Logo.astro';

const links = [
  { href: '/', label: 'Windows vs Linux' },
  { href: '/wiki', label: 'Wiki' },
  { href: '/distros', label: 'Escolha sua distro' },
  { href: '/quiz', label: 'Quiz' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav-wrap">
  <nav class="nav" aria-label="Principal">
    <a class="brand" href="/" aria-label="Distro Linux, início">
      <Logo size={28} />
    </a>
    <ul class="links" id="nav-links">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={{ active: l.href === path, soon: l.soon }}
            aria-disabled={l.soon ? 'true' : undefined}
            title={l.soon ? 'Em breve' : undefined}
          >{l.label}</a>
        </li>
      ))}
    </ul>
    <button class="theme-toggle" id="theme-toggle" aria-label="Alternar tema claro/escuro">
      <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="4.5" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
      <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
        <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" />
      </svg>
    </button>
    <a class="donate" href="https://buymeacoffee.com/samulls" target="_blank" rel="noopener" aria-label="Doações (Buy Me a Coffee)">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M17 8h1a4 4 0 1 1 0 8h-1" /><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" /><path d="M6 2v2M10 2v2M14 2v2" />
      </svg>
      <span>Doações</span>
    </a>
    <button class="menu-toggle" id="menu-toggle" aria-label="Abrir menu" aria-expanded="false" aria-controls="nav-links">
      <span></span><span></span>
    </button>
  </nav>
</header>

<script>
  // menu do celular: abre/fecha o painel de links
  const wrap = document.querySelector<HTMLElement>('.nav-wrap')!;
  const btn = document.getElementById('menu-toggle')!;
  const setOpen = (open: boolean) => {
    wrap.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
  };
  btn.addEventListener('click', () => setOpen(!wrap.classList.contains('open')));
  wrap.querySelectorAll('.links a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
  matchMedia('(min-width: 641px)').addEventListener('change', () => setOpen(false));
</script>

<style>
  /* barra de ponta a ponta, presa no topo, em liquid glass */
  .nav-wrap {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding-top: env(safe-area-inset-top, 0px);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--line);
    box-shadow: inset 0 -1px 0 var(--glass-shine);
    transition: background-color 0.5s var(--ease);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 48px;
    width: min(1024px, 100% - 44px);
    margin-inline: auto;
  }
  .brand { display: flex; align-items: center; }
  .brand:hover { text-decoration: none; }
  .links {
    display: flex;
    gap: 8px;
    list-style: none;
    margin: 0 auto;
    padding: 0;
  }
  .links a {
    display: block;
    padding: 6px 12px;
    font-size: 12px;
    color: var(--text-2);
    transition: color 0.2s;
  }
  .links a:hover { color: var(--text); text-decoration: none; }
  .links a.active { color: var(--text); }
  .links a.soon { opacity: 0.45; pointer-events: none; }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    transition: transform 0.4s var(--ease);
  }
  .theme-toggle:hover { transform: rotate(20deg) scale(1.08); }
  .theme-toggle svg { grid-area: 1 / 1; transition: transform 0.5s var(--ease), opacity 0.3s; }
  :global([data-theme='dark']) .sun { transform: rotate(90deg) scale(0); opacity: 0; }
  :global([data-theme='light']) .moon { transform: rotate(-90deg) scale(0); opacity: 0; }

  /* botão de doação, na ponta direita da barra */
  .donate {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 14px 0 11px;
    border-radius: 980px;
    background: var(--accent);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    transition: transform 0.3s var(--ease), box-shadow 0.3s;
  }
  .donate:hover { text-decoration: none; transform: scale(1.05); box-shadow: 0 6px 18px color-mix(in srgb, var(--accent) 45%, transparent); }
  .donate:hover svg { animation: steam 0.8s var(--ease); }
  @keyframes steam { 40% { transform: translateY(-2px) rotate(-8deg); } }

  .menu-toggle { display: none; }

  @media (max-width: 640px) {
    .nav { gap: 4px; width: calc(100% - 32px); }
    .brand { margin-right: auto; }
    /* no celular, só o ícone da xícara */
    .donate { width: 34px; height: 34px; padding: 0; justify-content: center; margin-left: 4px; }
    .donate span { display: none; }
    .menu-toggle {
      display: grid;
      place-content: center;
      gap: 6px;
      width: 40px;
      height: 40px;
      margin-right: -8px;
      border: 0;
      background: none;
      cursor: pointer;
    }
    .menu-toggle span {
      display: block;
      width: 18px;
      height: 1.5px;
      border-radius: 2px;
      background: var(--text);
      transition: transform 0.4s var(--ease);
    }
    .open .menu-toggle span:first-child { transform: translateY(3.75px) rotate(45deg); }
    .open .menu-toggle span:last-child { transform: translateY(-3.75px) rotate(-45deg); }

    /* painel de links que desce da barra */
    .links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      margin: 0;
      padding: 8px 16px 20px;
      background: color-mix(in srgb, var(--bg) 97%, transparent);
      backdrop-filter: blur(24px) saturate(180%);
      -webkit-backdrop-filter: blur(24px) saturate(180%);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 40px -20px rgba(0, 0, 0, 0.25);
      opacity: 0;
      transform: translateY(-8px);
      pointer-events: none;
      transition: opacity 0.3s var(--ease), transform 0.4s var(--ease);
    }
    .open .links { opacity: 1; transform: none; pointer-events: auto; }
    .links li { border-bottom: 1px solid var(--line); }
    .links li:last-child { border-bottom: 0; }
    .links a { padding: 16px 4px; font-size: 22px; font-weight: 600; letter-spacing: -0.02em; color: var(--text); }
    .links a.active { color: var(--accent); }
    .open .links li { animation: menuIn 0.4s var(--ease) both; }
    .open .links li:nth-child(2) { animation-delay: 0.04s; }
    .open .links li:nth-child(3) { animation-delay: 0.08s; }
    .open .links li:nth-child(4) { animation-delay: 0.12s; }
  }
  @keyframes menuIn { from { opacity: 0; transform: translateY(-6px); } }
</style>
