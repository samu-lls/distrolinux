---
import Base from '../layouts/Base.astro';
import { wiki, CATS } from '../data/wiki';
import { GROUP_LABEL } from '../data/compare';
import { logos } from '../data/logos';
import { PENGUIN_PATH, PENGUIN_VIEWBOX } from '../data/brand';
import { type Lang, tr, deepTr } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const t = (s: string) => tr(lang, s);
---

<Base title="Wiki · distrolinux" description={t('A árvore das distros Linux, em gotas.')} fullscreen lang={lang}>
  <section class="wiki" data-lenis-prevent>
    <canvas id="stage" aria-label={t('Árvore interativa das distribuições Linux')}></canvas>
    <div class="labels" id="labels" aria-hidden="true"></div>

    <div class="intro" id="intro">
      <p class="eyebrow">Wiki</p>
      <h1>{t('A árvore das distros.')}</h1>
      <p>{t('Clique numa gota para ver de onde cada distro veio.')}</p>
    </div>

    <div class="search glass">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input id="search" type="search" placeholder={t('Procurar distro')} autocomplete="off" aria-label={t('Procurar distro')} />
      <ul class="results glass" id="results" hidden></ul>
    </div>

    <!-- filtro por categoria: abre a árvore inteira e apaga o que não é da categoria -->
    <div class="filters" role="group" aria-label={t('Filtrar por categoria')}>
      <button data-cat="" aria-pressed="true">{t('Todas')}</button>
      {CATS.map((c) => <button data-cat={c} aria-pressed="false">{t(GROUP_LABEL[c])}</button>)}
      <button data-cat="old" aria-pressed="false">{t('Descontinuadas')}</button>
    </div>

    <div class="controls glass" role="toolbar" aria-label={t('Controles')}>
      <button id="zoom-out" aria-label={t('Diminuir zoom')}>−</button>
      <button id="zoom-in" aria-label={t('Aumentar zoom')}>+</button>
      <span class="sep"></span>
      <button id="center" class="text">{t('Centralizar')}</button>
      <button id="expand-all" class="text">{t('Abrir tudo')}</button>
      <button id="collapse-all" class="text">{t('Recolher')}</button>
    </div>
    <!-- mascote: dicas em balão, contextuais (avançam quando a pessoa faz o que foi sugerido) -->
    <div class="guide" id="guide">
      <button class="guide-avatar" id="guide-avatar" aria-label={t('Mostrar dicas')}>
        <svg viewBox={PENGUIN_VIEWBOX} fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d={PENGUIN_PATH} /></svg>
      </button>
      <div class="bubble glass" id="bubble" role="status" aria-live="polite">
        <button class="bubble-close" id="bubble-close" aria-label={t('Fechar dica')}>
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
        <p class="bubble-text" id="bubble-text"></p>
        <div class="bubble-foot">
          <span class="dots" id="dots"></span>
          <button class="bubble-next" id="bubble-next">{t('Próxima dica ›')}</button>
        </div>
      </div>
    </div>

    <aside class="panel glass" id="panel" hidden aria-live="polite">
      <button class="close" id="close" aria-label={t('Fechar')}>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
      <div class="panel-body" id="panel-body"></div>
    </aside>

    <p class="nogl" id="nogl" hidden>{t('Seu navegador não suporta WebGL, necessário para esta página.')}</p>
  </section>

  <script type="application/json" id="wiki-data" set:html={JSON.stringify(deepTr(lang, wiki))} />
  <script type="application/json" id="wiki-logos" set:html={JSON.stringify(logos)} />
  <script type="application/json" id="wiki-cats" set:html={JSON.stringify(Object.fromEntries(CATS.map((c) => [c, t(GROUP_LABEL[c])])))} />
</Base>

<style>
  .wiki {
    position: fixed;
    inset: 0;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
  }
  #stage { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; cursor: grab; }
  .labels { position: absolute; inset: 0; pointer-events: none; }
  .labels :global(.links) { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .labels :global(.links line) { stroke: var(--text-2); stroke-width: 1; stroke-dasharray: 2 4; stroke-linecap: round; opacity: 0; }
  /* ligações secundárias ("inspirada em", "usa ferramentas de"): tracejado mais longo, na cor de destaque */
  .labels :global(.links line.also) { stroke: var(--accent); stroke-dasharray: 7 6; stroke-width: 1.2; }
  .labels :global(.drop-label) {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    line-height: 1.1;
    color: var(--text);
    letter-spacing: -0.02em;
    will-change: transform, opacity;
    text-shadow: 0 1px 2px color-mix(in srgb, var(--bg) 70%, transparent);
  }
  .labels :global(.drop-label b) { font-weight: 700; }
  .labels :global(.drop-label .logo) { width: 2.4em; height: 2.4em; margin-bottom: 0.3em; object-fit: contain; color: var(--text); }
  .labels :global(.drop-label svg.logo) { fill: currentColor; }
  /* descontinuadas: logo sem cor e nome em itálico */
  .labels :global(.drop-label.old .logo) { filter: grayscale(1); }
  .labels :global(.drop-label.old b) { font-style: italic; font-weight: 600; }

  .filters {
    position: absolute;
    top: calc(env(safe-area-inset-top, 0px) + 122px);
    right: 24px;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    width: min(420px, calc(100vw - 48px));
    z-index: 2;
  }
  .wiki:has(.panel:not([hidden])) .filters { right: calc(min(400px, 100vw - 32px) + 32px); }
  .filters button {
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 980px;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    font: inherit;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-2);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .filters button:hover { color: var(--text); }
  .filters button[aria-pressed='true'] { background: var(--text); border-color: var(--text); color: var(--bg); }

  .intro {
    position: absolute;
    top: calc(env(safe-area-inset-top, 0px) + 72px);
    left: 24px;
    max-width: 320px;
    pointer-events: none;
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
  }
  .intro.gone { opacity: 0; transform: translateY(-10px); }
  .intro h1 { margin: 0; font-size: 32px; letter-spacing: -0.035em; line-height: 1.1; }
  .intro p:last-child { margin: 8px 0 0; color: var(--text-2); font-size: 15px; }
  .intro .eyebrow { font-size: 15px; margin-bottom: 4px; }

  .search {
    position: absolute;
    top: calc(env(safe-area-inset-top, 0px) + 72px);
    right: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    border-radius: 980px;
    width: min(280px, calc(100vw - 48px));
    color: var(--text-2);
    z-index: 3;
  }
  /* com o painel aberto, a busca vai para a esquerda dele */
  .wiki:has(.panel:not([hidden])) .search { right: calc(min(400px, 100vw - 32px) + 32px); }
  /* o campo ocupa a altura toda da caixa: dá pra tocar em qualquer ponto dela */
  .search input { flex: 1; min-width: 0; padding: 10px 0; border: 0; background: none; outline: none; font: inherit; font-size: 14px; color: var(--text); }
  .results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    margin: 0;
    padding: 6px;
    list-style: none;
    border-radius: 16px;
    max-height: 320px;
    overflow-y: auto;
  }
  .results button {
    display: flex;
    justify-content: space-between;
    width: 100%;
    padding: 9px 12px;
    border: 0;
    border-radius: 10px;
    background: none;
    font: inherit;
    font-size: 14px;
    color: var(--text);
    text-align: left;
    cursor: pointer;
  }
  .results button:hover, .results button:focus-visible { background: var(--line); outline: none; }
  .results small { color: var(--text-2); }

  .controls {
    position: absolute;
    left: 50%;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 44px);
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 5px;
    border-radius: 980px;
    z-index: 2;
  }
  .controls button {
    min-width: 34px;
    height: 34px;
    padding: 0 10px;
    border: 0;
    border-radius: 980px;
    background: none;
    font: inherit;
    font-size: 18px;
    color: var(--text);
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
  }
  .controls button.text { font-size: 13px; font-weight: 500; }
  .controls button:hover { background: var(--line); }
  .sep { width: 1px; height: 18px; background: var(--line); margin: 0 4px; }
  .hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 14px);
    margin: 0;
    padding-inline: 16px;
    text-align: center;
    font-size: 12px;
    color: var(--text-2);
    pointer-events: none;
  }

  /* ---------- Painel lateral ---------- */
  .panel {
    position: absolute;
    top: calc(env(safe-area-inset-top, 0px) + 64px);
    right: 16px;
    bottom: 16px;
    width: min(400px, calc(100vw - 32px));
    border-radius: 24px;
    overflow: hidden;
    z-index: 4;
    /* mais opaco que o vidro padrão: o texto do painel precisa vencer as gotas atrás */
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    animation: panelIn 0.5s var(--ease);
  }
  @keyframes panelIn { from { opacity: 0; transform: translateX(24px) scale(0.98); } }
  .panel-body { height: 100%; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--line) transparent; padding: 28px 26px 32px; user-select: text; -webkit-user-select: text; }
  .panel-body > :global(*) { animation: fadeUp 0.45s var(--ease) both; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(8px); } }
  .close {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 50%;
    background: var(--line);
    color: var(--text);
    cursor: pointer;
    z-index: 1;
  }
  .panel-body :global(.crumbs) { display: flex; flex-wrap: wrap; gap: 4px; margin: 0 40px 10px 0; font-size: 12px; color: var(--text-2); }
  .panel-body :global(.crumbs button) { border: 0; background: none; padding: 0; font: inherit; color: var(--accent); cursor: pointer; }
  .panel-body :global(h2) { margin: 0; font-size: 34px; letter-spacing: -0.04em; line-height: 1.05; }
  .panel-body :global(.meta) { margin: 6px 0 0; font-size: 14px; color: var(--text-2); }
  .panel-body :global(.desc) { margin: 18px 0 0; font-size: 15px; line-height: 1.55; }
  .panel-body :global(h3) { margin: 26px 0 10px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-2); font-weight: 600; }
  .panel-body :global(.facts) { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 0; }
  .panel-body :global(.fact) { padding: 10px 12px; border-radius: 12px; border: 1px solid var(--line); }
  .panel-body :global(.fact dt) { font-size: 11px; color: var(--text-2); }
  .panel-body :global(.fact dd) { margin: 2px 0 0; font-size: 14px; font-weight: 500; }
  .panel-body :global(.meter) { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 10px; margin-bottom: 10px; font-size: 14px; }
  .panel-body :global(.bars) { display: flex; gap: 3px; }
  .panel-body :global(.bars i) { width: 18px; height: 6px; border-radius: 3px; background: var(--line); }
  .panel-body :global(.bars i.on) { background: var(--c); }
  .panel-body :global(.chips) { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; padding: 0; margin: 0; }
  .panel-body :global(.chips li), .panel-body :global(.chips button) {
    padding: 5px 11px;
    border-radius: 980px;
    font: inherit;
    font-size: 13px;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
    border: 0;
  }
  .panel-body :global(.chips button) { cursor: pointer; }
  .panel-body :global(.chips button:hover) { background: color-mix(in srgb, var(--accent) 20%, transparent); }
  .panel-body :global(.chips .default) { background: var(--accent); color: #fff; }
  .panel-body :global(.for) { margin: 0; font-size: 15px; }
  .panel-body :global(.actions) { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .panel-body :global(.tags) { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0 0; padding: 0; list-style: none; }
  .panel-body :global(.tags li) { padding: 3px 10px; border-radius: 980px; font-size: 12px; font-weight: 600; background: var(--line); color: var(--text-2); }
  .panel-body :global(.tags .dead) { background: color-mix(in srgb, #ff453a 14%, transparent); color: #d70015; }
  :root[data-theme='dark'] .panel-body :global(.tags .dead) { color: #ff6961; }
  .panel-body :global(.also) { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .panel-body :global(.also button) { display: flex; justify-content: space-between; gap: 12px; width: 100%; padding: 9px 12px; border: 1px dashed color-mix(in srgb, var(--accent) 50%, transparent); border-radius: 12px; background: none; font: inherit; font-size: 14px; color: var(--accent); text-align: left; cursor: pointer; }
  .panel-body :global(.also small) { color: var(--text-2); font-size: 12px; }
  .panel-body :global(.actions .btn) { font-size: 15px; padding: 10px 18px; }

  /* ---------- Mascote ---------- */
  .guide {
    position: absolute;
    left: 20px;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 20px);
    display: flex;
    align-items: flex-end;
    gap: 10px;
    z-index: 3;
    pointer-events: none;
  }
  .guide > * { pointer-events: auto; }
  .guide-avatar {
    position: relative;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    flex: none;
    border: 1px solid var(--glass-border);
    border-radius: 50%;
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    cursor: pointer;
    animation: bob 3.2s ease-in-out infinite;
    transition: transform 0.4s var(--ease);
  }
  .guide-avatar svg { width: 44px; height: 25px; transform: scaleX(-1) translateX(3px); } /* olha para o balão */
  .guide-avatar:hover { transform: scale(1.08); }
  .guide.talking .guide-avatar svg { animation: talk 0.5s var(--ease); }
  .guide.closed .guide-avatar::after {
    content: '';
    position: absolute;
    top: 2px;
    right: 2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--surface);
  }
  @keyframes bob { 50% { translate: 0 -4px; } }
  @keyframes talk { 30% { transform: scaleX(-1) translateX(3px) rotate(10deg); } 60% { transform: scaleX(-1) translateX(3px) rotate(-4deg); } }

  .bubble {
    position: relative;
    width: min(300px, calc(100vw - 110px));
    margin-bottom: 18px;
    padding: 14px 16px 12px;
    border-radius: 18px 18px 18px 6px;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    transform-origin: 0 100%;
    transition: opacity 0.35s var(--ease), transform 0.45s var(--ease);
  }
  /* rabinho do balão apontando para o pinguim */
  .bubble::after {
    content: '';
    position: absolute;
    left: -7px;
    bottom: 10px;
    width: 14px;
    height: 14px;
    background: inherit;
    border-left: 1px solid var(--glass-border);
    border-bottom: 1px solid var(--glass-border);
    transform: rotate(45deg);
    border-radius: 0 0 0 4px;
  }
  .guide.closed .bubble { opacity: 0; transform: scale(0.6) translateY(10px); pointer-events: none; }
  .guide.pop .bubble { animation: pop 0.5s var(--ease); }
  @keyframes pop { from { transform: scale(0.85); opacity: 0.4; } }
  .bubble-text { margin: 0 22px 10px 0; font-size: 14px; line-height: 1.45; min-height: 2.9em; }
  .bubble-text :global(b) { font-weight: 600; }
  .bubble-close {
    position: absolute;
    top: 6px;
    right: 6px;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border: 0;
    border-radius: 50%;
    background: var(--line);
    color: var(--text-2);
    cursor: pointer;
  }
  .bubble-close:hover { color: var(--text); }
  .bubble-foot { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .dots { display: flex; gap: 4px; }
  .dots :global(i) { width: 5px; height: 5px; border-radius: 50%; background: var(--line); transition: background 0.3s, width 0.3s var(--ease); }
  .dots :global(i.on) { width: 14px; border-radius: 3px; background: var(--accent); }
  /* o espaçamento invisível deixa o alvo de toque com ~28px sem mexer no desenho */
  .bubble-next { border: 0; background: none; padding: 6px 0; margin: -6px 0; font: inherit; font-size: 13px; font-weight: 600; color: var(--accent); cursor: pointer; }

  .nogl { position: absolute; inset: 0; display: grid; place-items: center; padding: 24px; text-align: center; color: var(--text-2); }

  @media (max-width: 760px) {
    .intro { display: none; }
    .search, .wiki:has(.panel:not([hidden])) .search { left: 16px; right: 16px; width: auto; }
    /* no celular, os filtros viram uma faixa que rola de lado logo abaixo da busca */
    .filters, .wiki:has(.panel:not([hidden])) .filters {
      top: calc(env(safe-area-inset-top, 0px) + 116px);
      left: 0;
      right: 0;
      width: auto;
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      padding: 0 16px 4px;
      scrollbar-width: none;
    }
    .filters::-webkit-scrollbar { display: none; }
    .filters button { flex: none; min-height: 32px; }
    .controls .text:nth-of-type(4) { display: none; }
    .guide { bottom: calc(env(safe-area-inset-bottom, 0px) + 72px); left: 12px; }
    .wiki:has(.panel:not([hidden])) .guide { display: none; }
    .controls { bottom: calc(env(safe-area-inset-bottom, 0px) + 16px); }
    .panel { top: auto; left: 8px; right: 8px; bottom: 8px; width: auto; height: 52svh; }
    /* no celular a ficha cobre a parte de baixo: opaca, e os controles somem enquanto ela está aberta */
    .panel { background: color-mix(in srgb, var(--bg) 97%, transparent); }
    .wiki:has(.panel:not([hidden])) .controls { display: none; }
    @keyframes panelIn { from { opacity: 0; transform: translateY(40px); } }
  }
</style>

<script>
  import { createEngine } from '../scripts/wiki-engine';
  import type { WikiNode } from '../data/wiki';
  import { compareHref } from '../data/cmp-type';
  import { type Lang, tr, localePath } from '../i18n';

  // dados já chegam traduzidos; aqui só os textos da interface
  const lang: Lang = document.documentElement.lang.startsWith('en') ? 'en' : 'pt';
  const t = (s: string) => tr(lang, s);
  const nodes: WikiNode[] = JSON.parse(document.getElementById('wiki-data')!.textContent!);
  const byId = new Map(nodes.map((n) => [n.id, n]));
  const panel = document.getElementById('panel')!;
  const body = document.getElementById('panel-body')!;
  const intro = document.getElementById('intro')!;
  const isMobile = () => matchMedia('(max-width: 760px)').matches;
  const catLabel: Record<string, string> = JSON.parse(document.getElementById('wiki-cats')!.textContent!);

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function bars(label: string, v: number | undefined, color: string, hint: string) {
    if (!v) return '';
    const cells = Array.from({ length: 5 }, (_, i) => `<i class="${i < v ? 'on' : ''}"></i>`).join('');
    return `<div class="meter" title="${hint}"><span>${label}</span><span class="bars" style="--c:${color}">${cells}</span></div>`;
  }

  function actions(n: WikiNode) {
    const link = (href: string, text: string, primary: boolean) =>
      `<a class="btn ${primary ? 'btn-primary' : 'btn-link'}" href="${href}" target="_blank" rel="noopener">${text}</a>`;
    if (n.kind === 'root') return '';
    if (n.kind === 'hub') return n.site ? `<div class="actions">${link(n.site, n.id === 'linux' ? t('Conheça o kernel Linux ›') : t('Site oficial ›'), false)}</div>` : '';
    // distro ativa: atalho para o Comparador, já com ela na primeira coluna
    const cmp = !n.kind && !n.facts && n.cats?.length && !n.discontinued
      ? `<a class="btn btn-outline" href="${compareHref(n, localePath(lang, '/comparar'))}">${t('Comparar')}</a>` : '';
    const parts = [
      n.download && link(n.download, n.id === 'lfs' ? t('Ler o livro') : t('Baixar ISO'), true),
      cmp,
      n.site && n.site !== n.download && link(n.site, t('Site oficial ›'), !n.download),
    ].filter(Boolean);
    return parts.length ? `<div class="actions">${parts.join('')}</div>` : '';
  }

  function render(n: WikiNode) {
    const path: WikiNode[] = [];
    for (let p = n.parent ? byId.get(n.parent) : undefined; p; p = p.parent ? byId.get(p.parent) : undefined) path.unshift(p);
    const children = nodes.filter((x) => x.parent === n.id);
    const parent = n.parent ? byId.get(n.parent) : undefined;
    const facts = n.facts ?? [
      [t('Base'), parent && parent.kind !== 'group' ? parent.name : parent?.kind === 'group' ? t('Independente') : ''],
      [t('Lançamento'), n.model],
      [t('Pacotes'), n.pkg],
      [t('Loja de apps'), n.store],
      ['Init', n.init],
    ].filter(([, v]) => v);
    const easeColor = (n.ease ?? 0) >= 4 ? '#34c759' : (n.ease ?? 0) >= 3 ? '#ff9f0a' : '#ff453a';

    body.innerHTML = `
      ${path.length ? `<nav class="crumbs">${path.map((p) => `<button data-go="${p.id}">${esc(p.name)}</button> ›`).join(' ')}</nav>` : ''}
      <h2>${esc(n.name)}</h2>
      ${n.year || n.by ? `<p class="meta">${[n.year, n.by].filter(Boolean).map((x) => esc(String(x))).join(' · ')}</p>` : ''}
      ${n.cats?.length || n.discontinued ? `<ul class="tags">${n.discontinued ? `<li class="dead">${t('Descontinuada em')} ${n.discontinued}</li>` : ''}${(n.cats ?? []).map((c) => `<li>${esc(catLabel[c])}</li>`).join('')}</ul>` : ''}
      <p class="desc">${esc(n.desc)}</p>
      ${facts.length ? `<h3>${t('Ficha técnica')}</h3><dl class="facts">${facts.map(([k, v]) => `<div class="fact"><dt>${k}</dt><dd>${esc(v!)}</dd></div>`).join('')}</dl>` : ''}
      ${n.ease ? `<h3>${t('Na prática')}</h3>
        ${bars(t('Facilidade de uso'), n.ease, easeColor, t('5 = muito fácil'))}
        ${bars(t('Configuração necessária'), n.config, '#a855f7', t('5 = muita'))}
        ${bars(t('Uso de terminal'), n.terminal, 'var(--accent)', t('5 = constante'))}` : ''}
      ${n.des?.length ? `<h3>${t('Interfaces')}</h3><ul class="chips">${n.des.map((d, i) => `<li class="${i === 0 && n.des!.length > 1 ? 'default' : ''}" title="${i === 0 && n.des!.length > 1 ? t('Padrão') : ''}">${esc(d)}</li>`).join('')}</ul>` : ''}
      ${n.for ? `<h3>${t('Ideal para')}</h3><p class="for">${esc(n.for)}</p>` : ''}
      ${n.seenIn?.length ? `<h3>${t('Padrão em')}</h3><div class="chips">${n.seenIn.filter((id) => byId.has(id)).map((id) => `<button data-go="${id}">${esc(byId.get(id)!.name)}</button>`).join('')}</div>` : ''}
      ${children.length ? `<h3>${n.childrenLabel ?? (n.kind === 'root' ? t('Famílias') : n.kind === 'group' ? 'Distros' : t('Derivadas'))} (${children.length})</h3><div class="chips">${children.map((c) => `<button data-go="${c.id}">${esc(c.name)}</button>`).join('')}</div>` : ''}
      ${n.also?.length ? `<h3>${t('Também relacionada a')}</h3><ul class="also">${n.also.filter(([id]) => byId.has(id)).map(([id, why]) => `<li><button data-go="${id}">${esc(byId.get(id)!.name)}<small>${esc(why)}</small></button></li>`).join('')}</ul>` : ''}
      ${actions(n)}
    `;
    body.scrollTop = 0;
  }

  const engine = createEngine({
    canvas: document.getElementById('stage') as HTMLCanvasElement,
    labels: document.getElementById('labels')!,
    nodes,
    logos: JSON.parse(document.getElementById('wiki-logos')!.textContent!),
    panelWidth: () => (panel.hidden || isMobile() ? 0 : panel.offsetWidth + 16),
    panelHeight: () => (!panel.hidden && isMobile() ? panel.offsetHeight + 8 : 0),
    onSelect: (n) => {
      intro.classList.add('gone');
      if (!n) { panel.hidden = true; return; }
      panel.hidden = false;
      render(n);
    },
  });

  if (!engine) {
    document.getElementById('nogl')!.hidden = false;
  } else {
    body.addEventListener('click', (e) => {
      const go = (e.target as HTMLElement).closest<HTMLElement>('[data-go]');
      if (go) engine.reveal(go.dataset.go!);
    });
    document.getElementById('close')!.addEventListener('click', () => engine.deselect());
    document.getElementById('zoom-in')!.addEventListener('click', () => engine.zoom(1.3));
    document.getElementById('zoom-out')!.addEventListener('click', () => engine.zoom(1 / 1.3));
    document.getElementById('center')!.addEventListener('click', () => engine.center());
    document.getElementById('expand-all')!.addEventListener('click', () => { intro.classList.add('gone'); engine.expandAll(); });
    document.getElementById('collapse-all')!.addEventListener('click', () => { setFilter(''); engine.collapseAll(); });

    const filterBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-cat]')];
    const setFilter = (cat: string) => {
      filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.cat === cat)));
      engine.setFilter(cat || null);
    };
    filterBtns.forEach((b) => b.addEventListener('click', () => { intro.classList.add('gone'); setFilter(b.dataset.cat!); }));
    addEventListener('keydown', (e) => e.key === 'Escape' && engine.deselect());

    // /wiki#ubuntu abre direto na distro (usado pelo quiz)
    const openHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (id && byId.has(id)) setTimeout(() => engine.reveal(id), 250);
    };
    openHash();
    addEventListener('hashchange', openHash);

    /* ---------- Mascote: dicas contextuais ---------- */
    const touch = matchMedia('(pointer: coarse)').matches;
    // `on` = ação que conclui a dica e avança sozinha para a próxima
    // as dicas só avançam pelo botão "Próxima dica" (avançar por ação pulava várias de uma vez no scroll)
    const tips: string[] = [
      'Oi! Eu te ajudo por aqui. <b>Clique numa gota</b> para abrir: as distros estão dentro do <b>Linux</b>.',
      'Ao clicar numa gota, <b>todas as informações aparecem no painel</b>: ficha técnica, interfaces, onde baixar…',
      touch ? '<b>Faça pinça com dois dedos</b> para dar zoom e ver as gotas de perto.' : '<b>Gire o scroll do mouse</b> para dar zoom e ver as gotas de perto.',
      touch ? '<b>Arraste com o dedo</b> para passear pelo plano.' : '<b>Clique e arraste o fundo</b> para passear pelo plano.',
      'Cada gota <b>solta as derivadas</b> dela. Clicar de novo numa gota aberta <b>recolhe</b>.',
      'Procurando algo específico? <b>Use a busca</b> no canto superior, ou os <b>filtros</b> (Servidor, Celular, Jogos…) logo abaixo dela.',
      'As linhas <b>tracejadas coloridas</b> mostram ligações secundárias, e as gotas <b>apagadas</b> são distros que já foram descontinuadas.',
      'Quer ver tudo de uma vez? Toque em <b>“Abrir tudo”</b> lá embaixo. Bom passeio!',
    ].map(t);
    const guide = document.getElementById('guide')!;
    const bubbleText = document.getElementById('bubble-text')!;
    const dots = document.getElementById('dots')!;
    const nextBtn = document.getElementById('bubble-next') as HTMLButtonElement;
    dots.innerHTML = tips.map(() => '<i></i>').join('');
    let tip = 0;
    let typing = 0;

    function showTip(i: number) {
      tip = i;
      guide.classList.remove('closed', 'pop', 'talking');
      void guide.offsetWidth; // reinicia as animações
      guide.classList.add('pop', 'talking');
      [...dots.children].forEach((d, j) => d.classList.toggle('on', j === i));
      nextBtn.textContent = i === tips.length - 1 ? t('Entendi') : t('Próxima dica ›');
      // efeito de digitação (sem quebrar as tags <b>)
      clearInterval(typing);
      const html = tips[i];
      if (document.documentElement.classList.contains('reduced')) { bubbleText.innerHTML = html; return; }
      let n = 0;
      typing = window.setInterval(() => {
        n += 2;
        while (html[n - 1] === '<' || (html.lastIndexOf('<', n) > html.lastIndexOf('>', n - 1))) n++;
        bubbleText.innerHTML = html.slice(0, n);
        if (n >= html.length) clearInterval(typing);
      }, 18);
    }
    const advance = () => (tip < tips.length - 1 ? showTip(tip + 1) : guide.classList.add('closed'));

    nextBtn.addEventListener('click', advance);
    document.getElementById('bubble-close')!.addEventListener('click', () => guide.classList.add('closed'));
    document.getElementById('guide-avatar')!.addEventListener('click', () =>
      guide.classList.contains('closed') ? showTip(tip) : guide.classList.add('closed'),
    );
    setTimeout(() => showTip(0), 900);


    /* ---------- Busca ---------- */
    const input = document.getElementById('search') as HTMLInputElement;
    const results = document.getElementById('results')!;
    const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    input.addEventListener('input', () => {
      const q = norm(input.value.trim());
      const found = q ? nodes.filter((n) => n.kind !== 'group' && norm(n.name).includes(q)).slice(0, 8) : [];
      results.innerHTML = found
        .map((n) => `<li><button data-id="${n.id}">${esc(n.name)}<small>${esc(n.parent ? byId.get(n.parent)!.name : '')}</small></button></li>`)
        .join('');
      results.hidden = !found.length;
    });
    results.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-id]');
      if (!b) return;
      engine.reveal(b.dataset.id!);
      input.value = '';
      results.hidden = true;
      input.blur();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') (results.querySelector('button') as HTMLButtonElement | null)?.click();
      if (e.key === 'Escape') { input.value = ''; results.hidden = true; }
    });
  }
</script>
